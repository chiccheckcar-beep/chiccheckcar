rules_version = '2';
// Who may read and write what in the ChicCheckCar database.
// Paste into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'ankermeir2005@gmail.com';
    }
    function isStaff() {
      let p = /databases/$(database)/documents/approvals/$(request.auth.uid);
      return signedIn() && exists(p) && get(p).data.status == 'approved';
    }
    function isTeam() { return isOwner() || isStaff(); }
    function self(id) { return signedIn() && request.auth.uid == id; }

    // Leads: the owner and approved staff see and manage all of them.
    // A customer (anonymous visitor or signed-in account; the doc id is their uid) can read and write only their own lead,
    // and cannot set team-only fields: a status other than new/cold, merge marks, or the audit test flag after creation.
    function customerStatusOk() {
      return request.resource.data.get('status', 'new') in ['new', 'cold']
        || request.resource.data.get('status', '') == resource.data.get('status', '');
    }
    match /leads/{id} {
      // the team reads and works the leads; only the owner changes a customer's status (owner, 2026-10-25)
      allow read, create, delete: if isTeam();
      allow update: if isOwner()
        || (isStaff() && request.resource.data.get('status', '') == resource.data.get('status', ''));
      allow get: if self(id);
      allow create: if self(id) && request.resource.data.get('status', 'new') in ['new', 'cold']
        && !request.resource.data.keys().hasAny(['mergedInto', 'mergedFrom', 'mergedAt', 'mergedBy']);
      allow update: if self(id) && customerStatusOk()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['mergedInto', 'mergedFrom', 'mergedAt', 'mergedBy', 'test']);
    }

    // Purchase-process stage per request (shown to the customer in the personal area). Only the owner writes it.
    match /progress/{id} {
      allow read: if isTeam() || self(id);
      allow write: if isOwner();
    }

    // Staff accounts: a person creates their own request; only the owner sees the list.
    match /accounts/{id} {
      allow read: if isOwner() || self(id);
      allow create, update: if self(id);
      allow delete: if isOwner();
    }

    // Approvals: only the owner decides.
    match /approvals/{id} {
      allow read: if isOwner() || self(id);
      allow write: if isOwner();
    }
  }
}
